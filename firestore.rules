rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// 1. Collection: products
//    Fields: name, category, purchase_price, selling_price, stock, created_at, user_id, updated_at
//
// 2. Collection: transactions
//    Fields: transaction_code, created_at, total_amount, total_cost, total_items, items, user_id, status, customer_name, payment_method, paid_at
//
// 3. Collection: inventory_movements
//    Fields: product_id, product_name, type, quantity, reason, created_at, user_id
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function isValidProduct(data) {
      return data.name is string &&
             data.name.size() >= 1 && data.name.size() <= 60 &&
             data.category is string && data.category.size() <= 30 &&
             data.purchase_price is number && data.purchase_price >= 0 && data.purchase_price <= 999999999999 &&
             data.selling_price is number && data.selling_price >= 0 && data.selling_price <= 999999999999 &&
             data.stock is number && data.stock >= 0 && data.stock <= 1000000;
    }

    // Koleksi 1: Master Produk
    match /products/{productId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       isValidProduct(request.resource.data) &&
                       hasRequiredFields(['name', 'category', 'purchase_price', 'selling_price', 'stock', 'user_id']);
      allow update: if isAuthenticated() &&
                       isValidProduct(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Koleksi 2: Transaksi Penjualan (Kasir)
    match /transactions/{transactionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       hasRequiredFields(['transaction_code', 'total_amount', 'total_items', 'items', 'user_id']);
      // Mengizinkan pembaruan status pelunasan (LUNAS, metode pembayaran QRIS/Tunai)
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Koleksi 3: Mutasi Inventaris
    match /inventory_movements/{movementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                       hasRequiredFields(['product_id', 'product_name', 'type', 'quantity', 'reason', 'user_id']);
      allow update, delete: if false; // Log mutasi stok bersifat audit trail immutable
    }
  }
}